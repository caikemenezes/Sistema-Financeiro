// Prisma schema — Sistema Financeiro Familiar
// Etapa 1: Receitas, Contas do Mês, Cartão de Crédito, Metas e Prioridades, Família e Filhos, Dívidas
// Ver documentação completa no cofre Obsidian "Finaças memoria/Sistema Financeiro"

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum StatusRecebimento {
  PREVISTO
  RECEBIDO
}

enum StatusConta {
  PENDENTE
  PAGA
  ATRASADA
}

enum TipoConta {
  FIXA
  VARIAVEL
}

enum Prioridade {
  URGENTE
  ALTA
  MEDIA
  BAIXA
}

enum StatusMeta {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum StatusDivida {
  EM_DIA
  ATRASADA
  QUITADA
}

model FamiliaMembro {
  id             String    @id @default(cuid())
  nome           String
  parentesco     String
  dataNascimento DateTime?
  observacoes    String?
  createdAt      DateTime  @default(now())

  necessidades Necessidade[]
  metas        Meta[]
}

model Receita {
  id              String            @id @default(cuid())
  nome            String
  tipo            String
  valorPrevisto   Float
  valorRecebido   Float?
  dataPrevista    DateTime
  dataRecebimento DateTime?
  categoria       String?
  recorrente      Boolean           @default(false)
  contaBancaria   String?
  status          StatusRecebimento @default(PREVISTO)
  observacao      String?
  createdAt       DateTime          @default(now())
}

model ContaMes {
  id               String      @id @default(cuid())
  nome             String
  categoria        String
  subcategoria     String?
  valor            Float
  vencimento       DateTime
  formaPagamento   String?
  contaBancaria    String?
  tipo             TipoConta   @default(FIXA)
  recorrenteMensal Boolean     @default(true)
  status           StatusConta @default(PENDENTE)
  dataPagamento    DateTime?
  observacoes      String?
  createdAt        DateTime    @default(now())
}

model Meta {
  id                    String         @id @default(cuid())
  nome                  String
  tipo                  String
  categoria             String?
  valorEstimado         Float
  valorGuardado         Float          @default(0)
  dataDesejada          DateTime?
  prioridade            Prioridade     @default(MEDIA)
  status                StatusMeta     @default(PLANEJADA)
  familiaMembroId       String?
  familiaMembro         FamiliaMembro? @relation(fields: [familiaMembroId], references: [id])
  observacoes           String?
  linksPesquisados      String?
  orcamentosEncontrados String?
  createdAt             DateTime       @default(now())

  cotacoes         MetaCotacao[]
  itensNecessarios MetaItemNecessario[]
}

model MetaCotacao {
  id         String   @id @default(cuid())
  metaId     String
  meta       Meta     @relation(fields: [metaId], references: [id], onDelete: Cascade)
  item       String
  fornecedor String
  valor      Float
  link       String?
  escolhida  Boolean  @default(false)
  observacao String?
  createdAt  DateTime @default(now())
}

model MetaItemNecessario {
  id            String   @id @default(cuid())
  metaId        String
  meta          Meta     @relation(fields: [metaId], references: [id], onDelete: Cascade)
  nome          String
  valorEstimado Float
  concluido     Boolean  @default(false)
  observacao    String?
  createdAt     DateTime @default(now())
}

model Necessidade {
  id              String         @id @default(cuid())
  item            String
  familiaMembroId String?
  familiaMembro   FamiliaMembro? @relation(fields: [familiaMembroId], references: [id])
  pessoaNome      String?
  categoria       String
  prioridade      Prioridade     @default(MEDIA)
  valorEstimado   Float
  valorGuardado   Float          @default(0)
  mesPlanejado    DateTime
  status          StatusMeta     @default(PLANEJADA)
  createdAt       DateTime       @default(now())
}

model Divida {
  id                      String       @id @default(cuid())
  nome                    String
  credor                  String
  tipo                    String
  valorOriginal           Float
  valorAtual              Float
  juros                   Float?
  numeroParcelas          Int?
  valorParcela            Float?
  vencimento              DateTime?
  parcelasPagas           Int          @default(0)
  status                  StatusDivida @default(EM_DIA)
  prioridade              Prioridade   @default(MEDIA)
  possibilidadeNegociacao Boolean      @default(false)
  observacoes             String?
  createdAt               DateTime     @default(now())
}

model Investimento {
  id                     String    @id @default(cuid())
  nome                   String
  objetivo               String
  instituicao            String?
  tipo                   String?
  valorAplicado          Float
  valorAtual             Float
  aporteMensal           Float?
  dataUltimoAporte       DateTime?
  prazo                  DateTime?
  liquidez               String?
  rentabilidadeInformada String?
  observacoes            String?
  createdAt              DateTime  @default(now())
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())

  sessoes Sessao[]
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  createdAt DateTime @default(now())
}
